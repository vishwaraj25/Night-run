; Traps — placed with intent, not just scattered. Each one is either a
; difficulty-curve step (street's bot is a safe first look at a stationary
; shooter; the approach gate is the hardest single check in the level) or a
; "pressure funnels you somewhere worse" moment (see the fork 2 turret).

; --- street: safe first look at a stationary shooter, plenty of room to
; approach from a distance before it's in range ---
[node name="TrapBotStreet" parent="." instance=ExtResource("19")]
position = Vector2(3650, 500)

; --- fork 1 underpass: lands right where the low route's exit ramp finishes
; climbing back up to the rejoin — you're already moving forward off the
; ramp, so this demands a timed hop, not just a walk-through ---
[node name="TrapSpikesFork1" parent="." instance=ExtResource("20")]
position = Vector2(6000, 700)

; --- speed track: the one long, gap-free stretch in the level. A stationary
; shooter here is what actually makes the run-and-gun jumping/weaving the
; level's built around, since there's nothing else to dodge but this ---
[node name="TrapBotSpeedTrack" parent="." instance=ExtResource("19")]
position = Vector2(10500, 500)

; --- fork 2: the deliberate "forced down into a trap" moment. There's a
; strut connecting the high route to mid tier at x=16975 (a grunt is already
; timelined to press you right around there in enemy_spawner.gd) -- a
; player retreating from that grunt by dropping to mid tier lands right in
; front of this turret instead. Escaping one threat walks you into another.
[node name="TrapTurretFork2Ambush" parent="." instance=ExtResource("21")]
position = Vector2(17000, 620)

; --- tower: no safe resting spots even on the flat bits between climbs ---
[node name="TrapSpikesTower" parent="." instance=ExtResource("20")]
position = Vector2(22000, 260)

; --- tower: timed against the ramp climb at x=20600-20750. The beam's off
; window (1.8s default) is comfortably longer than the ~0.6s it takes to
; walk the ramp, so it's a real "wait for the gap" beat, not a coinflip ---
[node name="TrapCeilingBeamTower" parent="." instance=ExtResource("22")]
position = Vector2(20675, 100)
beam_length = 225.0

; --- approach: the hardest single check in the level, right before the
; boss door. Spans the 150px gap between the last two approach platforms --
; a jump that was previously trivial now has to be timed against the gate.
[node name="TrapLaserGateApproach" parent="." instance=ExtResource("23")]
position = Vector2(25250, 500)
far_offset = Vector2(150, 0)

; --- approach: one last threat after the gate, right before the gear
; chamber door, keeping pressure up to the very end ---
[node name="TrapBotApproachFinal" parent="." instance=ExtResource("19")]
position = Vector2(26000, 500)

; --- Support pickups. Placed as recovery beats: a medkit right after each
; fork's hard stretch and one before the boss door, and jetpacks at the two
; places where vertical movement is the actual problem (the tower climb, and
; the arena's ledges). 10s of fuel is deliberately short of "fly the level" ---


[node name="CrateJetpackSpeed" parent="." instance=ExtResource("10")]
position = Vector2(10600, 440)
item_name = "jetpack"


[node name="CrateJetpackTower" parent="." instance=ExtResource("10")]
position = Vector2(20300, 360)
item_name = "jetpack"



[node name="CrateJetpackArena" parent="." instance=ExtResource("10")]
position = Vector2(26900, 440)
item_name = "jetpack"

; --- Medkits. Four reachable on any single run, spaced so one arrives at the
; end of each stretch that actually costs you health: after fork 1, after
; fork 2, on top of the tower climb, and at the boss door. The forked
; sections carry one per tier because you only ever see the tier you took.
;
; y is the platform surface MINUS 55. Sitting them at the surface put half the
; 50px-tall pickup box inside the 26px slab, which is why they looked sunk
; into the tiles. ---

[node name="MedkitFork1High" parent="." instance=ExtResource("10")]
position = Vector2(6700, 285)
item_name = "medkit"

[node name="MedkitFork1Low" parent="." instance=ExtResource("10")]
position = Vector2(6900, 645)
item_name = "medkit"

[node name="MedkitFork2High" parent="." instance=ExtResource("10")]
position = Vector2(16300, 285)
item_name = "medkit"

[node name="MedkitFork2Mid" parent="." instance=ExtResource("10")]
position = Vector2(16700, 565)
item_name = "medkit"

[node name="MedkitFork2Low" parent="." instance=ExtResource("10")]
position = Vector2(16300, 845)
item_name = "medkit"

[node name="MedkitTowerTop" parent="." instance=ExtResource("10")]
position = Vector2(21950, 205)
item_name = "medkit"

[node name="MedkitBossDoor" parent="." instance=ExtResource("10")]
position = Vector2(26300, 445)
item_name = "medkit"

; --- Checkpoints. Three, each on flat quiet ground with no encounter within a
; screen of it: after fork 1's routes rejoin, after fork 2's do, and at the
; boss door. The last one is the one that matters most -- without it, every
; attempt at the boss meant replaying 27,000px of level. y is the platform
; surface, since the pylon is drawn upward from its base. ---

[node name="CheckpointAfterFork1" parent="." instance=ExtResource("24")]
