; Crates sit on top of specific authored platforms — see level_builder.gd's
; PLATFORMS list; each y is ~60px above that platform's surface. Which route
; you take decides which weapons you get.

; --- street: first pickup, on the opening ground ---
[node name="CrateDoubleMG" parent="." instance=ExtResource("10")]
position = Vector2(1200, 440)
item_name = "double_mg"
weapon_scene = ExtResource("17")

; --- fork 1: high road reward ---
