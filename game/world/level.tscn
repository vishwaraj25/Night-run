position = Vector2(5150, 640)
item_name = "flamethrower"

; --- speed track ---
[node name="CrateFlamethrowerSpeed" parent="." instance=ExtResource("10")]
position = Vector2(10200, 440)
item_name = "flamethrower"

; --- fork 2: one reward per tier ---
[node name="CrateLaserHigh2" parent="." instance=ExtResource("10")]
position = Vector2(15050, 280)
item_name = "laser"
